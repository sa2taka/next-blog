{
  "name": "blog",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm-watch build-image & astro dev",
    "build": "yarn create-rss-feed && yarn build-image && astro build",
    "preview": "astro preview",
    "lint": "eslint . && astro check",
    "build-image": "node ./scripts/build-public-image.mjs",
    "create-rss-feed": "yarn tsx ./scripts/create-rss-feed.mts"
  },
  "watch": {
    "build-image": "../../_data/_images/**/*"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@iktakahiro/markdown-it-katex": "^4.0.1",
    "astro": "7.4.2",
    "glob": "^13.0.0",
    "image-size": "^2.0.0",
    "imagemin": "^9.0.0",
    "imagemin-gifsicle": "^7.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-webp": "^8.0.0",
    "markdown-it": "^14.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-imsize": "^2.0.1",
    "markdown-it-sanitizer": "^0.4.3",
    "prismjs": "^1.28.0",
    "rss": "1.2.2",
    "sync-fetch": "^0.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@emnapi/runtime": "1.11.3",
    "@types/html-to-text": "9.0.4",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.13.3",
    "@types/prismjs": "1.26.6",
    "@types/sync-fetch": "0.4.4",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.2.1",
    "html-to-text": "10.0.0",
    "nodemon": "3.1.14",
    "npm-watch": "0.13.0",
    "tsx": "4.23.9",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sa2taka/next-blog.git"
  },
  "author": "sa2taka",
  "license": "MIT"
}
