---
import '@blog/styles/global.css';
import Footer from '@blog/components/Footer.astro';
import Header from '@blog/components/Header.astro';
import {
  BASE_URL,
  BLOG_DEFAULT_TITLE,
  BLOG_DESCRIPTION,
  BLOG_TITLE,
  OG_LOCALE,
  TWITTER_SITE,
} from '@blog/libs/const';
import {
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_ALT,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_TYPE,
  DEFAULT_OG_IMAGE_WIDTH,
  DEFAULT_TWITTER_IMAGE,
} from '@blog/libs/ogImage';
import type { PageMeta } from '@blog/libs/pageMeta';

type Props = PageMeta;

const {
  title = BLOG_DEFAULT_TITLE,
  description = BLOG_DESCRIPTION,
  ogTitle = BLOG_DEFAULT_TITLE,
  ogType = 'website',
  ogImage,
  ogImageAlt = DEFAULT_OG_IMAGE_ALT,
  twitterCard = 'summary',
  noindex = false,
  article,
  jsonLd,
  katex = false,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, BASE_URL).toString();
const ogImageUrl = ogImage ?? DEFAULT_OG_IMAGE;
const twitterImageUrl = ogImage ?? DEFAULT_TWITTER_IMAGE;
const isDefaultOgImage = ogImageUrl === DEFAULT_OG_IMAGE;
---

<!doctype html>
<html lang="ja" class="theme--dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    {
      isDefaultOgImage && (
        <>
          <meta property="og:image:type" content={DEFAULT_OG_IMAGE_TYPE} />
          <meta property="og:image:width" content={DEFAULT_OG_IMAGE_WIDTH.toString()} />
          <meta property="og:image:height" content={DEFAULT_OG_IMAGE_HEIGHT.toString()} />
        </>
      )
    }
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={OG_LOCALE} />
    <meta property="og:site_name" content={BLOG_TITLE} />
    <meta property="og:url" content={pageUrl} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          <meta property="article:modified_time" content={article.modifiedTime} />
        </>
      )
    }
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="twitter:site" content={TWITTER_SITE} />
    {article && <meta name="twitter:creator" content={TWITTER_SITE} />}
    <link rel="canonical" href={pageUrl} />
    {
      jsonLd && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
      )
    }

    <link rel="preload" as="image" href="/icon.webp" />
    <link rel="preload" as="image" href="/icon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icons/icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/icons/icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/icons/icon-152x152.png" />
    <meta name="theme-color" content="#009688" />
    {
      katex && (
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/katex@0.16.0/dist/katex.min.css"
          integrity="sha384-Xi8rHCmBmhbuyyhbI88391ZKP2dmfnOl4rT9ZfRI7mLTdk1wblIUnrIq35nqwEvC"
          crossorigin="anonymous"
        />
      )
    }

    <!-- 初回ペイント前に保存済みテーマを反映し、画面のフラッシュを防ぐ -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.classList.replace('theme--dark', 'theme--light');
        }
      } catch (e) {
        // localStorage が使えない環境では既定のダークテーマのままにする
      }
    </script>
  </head>
  <body>
    <div class="app-root">
      <Header />
      <div class="app-main-container">
        <main class="app-main">
          <slot />
        </main>
      </div>
      <Footer />
    </div>
  </body>
</html>
